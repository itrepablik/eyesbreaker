{
  "name": "eyesbreaker-desktop",
  "version": "0.1.0",
  "description": "Eyesbreaker 20-20-20 rule desktop app for Windows, macOS, and Linux.",
  "author": "INT8Code",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p ./",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.eyesbreaker.desktop",
    "productName": "Eyesbreaker",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../assets/eyesbreaker.png",
        "to": "assets/eyesbreaker.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "publisherName": "INT8Code"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.healthcare-fitness"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
